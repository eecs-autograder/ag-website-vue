FROM ubuntu:jammy

RUN mkdir -p /usr/src/app/src
RUN apt-get update --fix-missing

WORKDIR /usr/src/app

RUN apt-get install -y curl gnupg wget
# Download the Node binary matching the build architecture so the image can be
# built natively on both amd64 and arm64 (e.g. Apple Silicon) hosts.
RUN ARCH="$(dpkg --print-architecture)" && \
    case "$ARCH" in \
      amd64) NODE_ARCH=x64 ;; \
      arm64) NODE_ARCH=arm64 ;; \
      *) echo "Unsupported architecture: $ARCH" && exit 1 ;; \
    esac && \
    wget "https://nodejs.org/dist/v16.9.1/node-v16.9.1-linux-${NODE_ARCH}.tar.gz" && \
    tar -xf "node-v16.9.1-linux-${NODE_ARCH}.tar.gz" -C /usr/local --strip-components=1 --no-same-owner

COPY ag-client-typescript ./ag-client-typescript
COPY package.json .
COPY package-lock.json .
COPY .browserslistrc .
COPY .postcssrc.js .
COPY vue.config.js .
COPY tsconfig.json .

RUN npm ci
